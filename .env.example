GOOGLE_GENAI_USE_VERTEXAI=TRUE

# Two different things with almost the same name, and they are not
# interchangeable. PROJECT is the string id you see in the console and is what
# the genai client wants; PROJECT_NUMBER is the digits, and only that form works
# in the Search grounding URL `_client.py` builds. Setting either one to the
# other's value fails at the first grounded question, not at startup.
#
# Left empty on purpose, and not filled with a `my-project-id` placeholder:
# `check_env` tests presence, so a plausible-looking value here is a value, and
# an unedited `cp .env.example .env` would start clean and fail one thin card at
# a time. `tools/env_check.py` puts this file through `check_env` to keep it so.
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_PROJECT_NUMBER=

GOOGLE_CLOUD_LOCATION=us-central1

# Read only when GOOGLE_GENAI_USE_VERTEXAI is not TRUE. The Vertex path
# authenticates with ADC and never looks at this, so a key set here on a Vertex
# machine does nothing — and a missing-ADC failure then reads as a rejected key.
#
# Leaving it empty is not the same as having no key: google-genai then falls
# back to GOOGLE_API_KEY and GEMINI_API_KEY from the environment, and the README
# tells you to set GOOGLE_API_KEY for Chromium's geolocation. So on the non-
# Vertex path a key you did not put here can still be the one in use.
GOOGLE_CLOUD_API_KEY=

GOOGLE_MAPS_API_KEY=

# Fallback address for "here" and "nearby". The location is normally set by pin
# in the settings sheet and sent on the WebSocket handshake; this is what a
# terminal nobody has set up yet uses instead.
HOME_LOCATION=

# The same place as coordinates, "lat,lng", for the half of the server that
# runs with no browser in front of it: the clock page's weather is fetched by
# a background task, and the handshake's pin is not there to be asked. Unset,
# HOME_LOCATION above is geocoded once per process instead, which costs one
# model call and is exact to well inside a weather grid cell — so this is
# worth setting only on a terminal with no HOME_LOCATION, or one that wants
# its weather without credentials.
# HOME_COORDS=35.681,139.767

# Where the picture behind the clock is kept. Outside the package on purpose:
# the Pi deploy copies files over `static/`, so anything left there is gone on
# the next deploy. Relative paths resolve against the working directory, same
# as GWS_CACHE_DIR and SESSIONS_DB. An empty or missing directory is fine and
# is what every terminal has until the generator lands.
#
# The working directory is where that deploy copies *to*, and the copy runs
# with --delete, so whatever name is used here is also one of the rsync's
# --excludes in the README. Change one and change the other.
# SCREENSAVER_DIR=screensaver

# Who draws that picture. When is not configurable: seven times a local day,
# six of them an hour either side of sunrise and sunset and the seventh at
# 21:00, which is what the owner asked for and is seven 2K generations a day
# forever on a machine that is never switched off.
#
# The model id is a variable rather than a literal because it is the one part
# of this that could not be settled without spending a call: google-genai
# never validates a model name, so the wrong id is a 404 at 06:00 on a Pi and
# the fix for it should not be a deploy. `nano-banana-pro-preview` is the
# other name the SDK writes down for the same model.
# SCREENSAVER_MODEL=gemini-3-pro-image

# How many days of weather that picture is drawn from. The date and this many
# days of temperature go into the prompt and the model works out what the
# season looks like; until #185 a table turned the month into one word and the
# panel drew autumn foliage on a 30 C September day.
#
# A knob on how the picture looks rather than a fact about the code, which is
# why it is here and not a constant: trying seven, then ten, then five means
# standing in front of the panel, and on the constant path each attempt is a
# commit and a deploy. Seven damps a cold snap without lagging the actual turn
# of a season. Unset, empty, unparseable or outside 1-92 is seven.
# SCREENSAVER_SEASON_DAYS=7

# The voice, and the sidecar the grounded tools run on. `gemini-3.8-live` is
# the Live API model and is served on Vertex from us-central1, so running it
# requires GOOGLE_CLOUD_LOCATION=us-central1. Flash-Lite is the grounding tier
# because that extra round trip has to fit inside a spoken turn; which Flash-Lite
# is not a judgement call, and `tools/models_check.py` fails when it falls behind.
# LIVE_MODEL=gemini-3.8-live
# GROUNDING_MODEL=gemini-3.5-flash-lite

# Which voice a terminal nobody has asked answers in. One of Kore, Puck,
# Charon, Aoede, Fenrir — anything else is refused at startup and Kore is used,
# because a name the Live API does not know is not a wrong voice, it is a
# connection that never comes up. The settings sheet picks per terminal; this
# is what a fresh one starts on.
# LIVE_VOICE=Kore

# The Workspace sub-agent. 3.8 Flash is only served from the global endpoint,
# so it needs its own location rather than GOOGLE_CLOUD_LOCATION.
# GWS_MODEL=gemini-3.8-flash
# GWS_LOCATION=global
# GWS_BIN is only needed when the CLI is not on PATH, but a gws the terminal
# can find is not optional: without one the Workspace tool refuses every
# question, and startup says which of the two you are missing.
# GWS_BIN=/usr/local/bin/gws
# Keyring backend for gws on headless systems without a desktop secret service.
# GOOGLE_WORKSPACE_CLI_KEYRING_BACKEND=file
# GWS_CACHE_DIR=gws_cache

# How much that cache is allowed to hold before the oldest documents are
# dropped. Two caps because the two costs are different: every turn stats and
# reads every cached file, so the read cost is a count, and the SD card wears
# by bytes. Raise the count and every turn gets slower; there is no setting
# here that keeps a document forever, because Drive already does.
#
# Neither is a switch. 0 or less on either one is not "no cap": the newest
# document is the only one an eviction spares, so the next fetch would delete
# every other document in the cache and leave the single file it just wrote.
# The server refuses to start on either of them rather than guess.
# GWS_CACHE_MAX_FILES=200
# GWS_CACHE_MAX_BYTES=67108864

# Where the conversations are kept. A SQLite file, read back into the model on
# the next connection, so this is the household talking to itself: keep it on
# the SD card next to gws_cache and off any share. Relative paths resolve
# against the working directory.
# SESSIONS_DB=sessions.db

# How long the room can be quiet before the next hello is a new conversation
# rather than the same one continued. Longer and every hello replays more talk
# than the last. Shorter costs less than it looks: the thread being left behind
# is summarised into the one replacing it, so "book it for the same time" still
# means something across the gap.
#
# Not the only thing that ends a conversation any more, and no longer the
# thing that bounds one. The panel's own screensaver ends it: three minutes
# after the last word or touch the face comes back up, the page says so, and
# the next wake word starts a new thread. That is the rule that keeps a wake
# word cheap — a kitchen in use never goes quiet for half an hour, so before
# it, a day's talk was replayed into the Live connection on every hello and
# the arm cost whatever the day had cost so far. This number is what is left
# for a page that never slept, such as a tab on a Mac, and it is still what
# decides which conversation a page load belongs to.
#
# Not a switch either, and the two readers of it disagree about the bad
# values: 0 or less starts a new conversation at every hello and pays a
# summary for each, nan grows one thread forever while starting a new one at
# every wake word, and inf never rolls at all. The server refuses to start on
# anything that is not a finite number above zero.
# SESSION_IDLE_GAP_S=1800

# How long a conversation nobody has come back to is kept. Nothing else ever
# takes a row out of SESSIONS_DB, and both queries on the path of every page
# load are linear in how many rows there are. A floor and not a ceiling: the
# thread somebody is in is never dropped, however old it is.
#
# The window is per person and not per household: the sweep runs on somebody's
# own hello and lists only their threads, so a profile nobody connects as any
# more keeps everything it had, for as long as the file lasts. Renaming
# somebody in PROFILES makes one of those — the new name is a new person, and
# the old name's conversations stay behind with nothing that will visit them.
#
# Not a switch. 0 or less is not "keep everything": it puts the cutoff at now,
# so every thread but the one being resumed goes on the next hello. There is
# no value that turns the sweep off, and the server refuses to start on
# anything that is not a finite number of seconds above zero, rather than
# guess which way you meant it.
# SESSION_RETAIN_S=2592000

# That summary. It is one Gemini call on the small model, made while somebody
# is standing at the terminal waiting for the first hello after a gap, so the
# budget is what the wait is worth rather than what the call needs — over it,
# the new conversation simply starts with nothing behind it. The other number
# is how much of the old conversation is read, newest first.
#
# The budget wants a finite number above zero and the server refuses to start
# on anything else. 0 or less does not skip the call, it pays for it and
# throws the answer away on every rollover; inf is no budget at all; and nan
# is the one that hurts — asyncio hands it straight to the selector, which
# raises from the event loop rather than from the summary, so the server dies
# on the first hello after a quiet half hour.
#
# The length wants a whole number above zero, same refusal. 0 is not "read
# all of it": the trim keeps nothing, so every thread rolls with no recap and
# nothing says so.
# RECAP_BUDGET_S=6
# RECAP_INPUT_CHARS=6000

# How long the terminal stays armed after the wake word with nobody saying
# anything, before the microphone goes off and the Live session closes with it.
# The page reads this off /api/config and resets the countdown on anything the
# model says and anything typed at it, so a long answer cannot be cut in half
# by it. Raise it and an empty kitchen is listening for longer; lower it much
# below ten seconds and thinking about the follow-up costs you the wake word
# again.
#
# A finite number above zero, and the server refuses to start otherwise. 0 is
# not "listen until somebody says something": the page keeps its own 30 s and
# nothing tells you it did. nan and inf go the same way — /api/config sends
# them on as null, which the page discards exactly as it discards 0.
# WAKE_IDLE_S=30

# Who the terminal keeps a separate conversation for. Comma-separated, and it
# only puts a picker in the settings sheet — anyone standing at the kitchen
# counter can select any of these names and read that person's history back.
# Unset, everyone shares one conversation under the name `terminal`.
# PROFILES=alex,sam

# The browse tool. BROWSE_ALLOWLIST is a comma-separated list of hostnames the
# browser may open; suffixes match, so `jorudan.co.jp` also allows `www.`.
# Empty means anywhere, which is the default — the safety that matters is that
# the profile is thrown away every run, password fields are hidden from the
# model, and it refuses to click anything that buys, books, sends or logs in.
# Hostnames and nothing else: `*`, `*.jorudan.co.jp` and a scheme-prefixed
# entry are each refused at the start of a browse, naming the entry, because
# the match is against a page's host and no host is any of those. Empty is the
# only spelling of "anywhere", and BROWSE_CDP below will not take it.
# BROWSE_CHROMIUM is the system Chromium to drive; unset uses Playwright's own,
# which does not exist on arm64 Linux. The Pi needs it, macOS does not — it is
# mandatory there, and startup says so when it is unset or names nothing that
# runs. A path, not a name: Playwright never searches PATH for it, so a bare
# `chromium` is refused even on a machine where `which chromium` finds one.
# BROWSE_MODEL always goes to the global endpoint, whatever GOOGLE_CLOUD_LOCATION
# says, because 3.8 Flash is served from there and nowhere else.
#
# BROWSE_CDP is a devtools endpoint to attach to instead of launching. Unset,
# which is a headless throwaway logged out of everything. Set on the panel,
# where the browser worth driving is the one already up: it is signed into
# whatever somebody signed it into, and a Chromium profile directory takes one
# process at a time, so there is no second browser to put on that profile. On
# the Pi that is http://127.0.0.1:9222, and it is refused until the kiosk unit
# carrying --remote-debugging-port is the one on the device. `pi_deploy.py
# deploy` copies it and `restart` re-execs Chromium onto it; before #183 it did
# neither, and this endpoint refused on every Pi. README, "The kiosk's
# debugging port".
#
# Setting it changes what a page the agent reads is reading with. The run then
# holds the profile's live sessions, so the throwaway-profile half of the
# BROWSE_ALLOWLIST note above stops applying to it. Which is why the two are
# set together or not at all: with BROWSE_CDP set and BROWSE_ALLOWLIST empty,
# browse refuses to connect and says so, rather than taking "anywhere" as a
# default on somebody else's profile.
#
# The allowlist is only half of it: it says where an attached run may go and
# nothing about what it may do there. The other half is not a variable and is
# not configurable — with BROWSE_CDP set, `press` is limited to the keys that
# scroll (so no Enter, no Control+Enter, no single-character shortcut) and a
# click whose label archives, shares, forwards or transfers is refused on top
# of the ones that buy or send. Reading, navigating and typing stay free.
# README, "The browser tool", under "What it will not do".
#
# These two are the only numbers here that are not checked, on purpose:
# `nan` and `inf` are already a ValueError out of the step cap, and the rest
# is bounded and says so out loud. A step cap of 0 or less runs no steps and
# answers "I could not find that"; a budget of 0 or less breaks on the first
# check and answers "I ran out of time looking that up"; a budget of nan or
# inf never fires and the step cap holds the run instead. Both are read on
# every browse rather than at startup, so there is nothing to refuse at.
# BROWSE_MODEL=gemini-3.8-flash
# BROWSE_MAX_STEPS=10
# BROWSE_BUDGET_S=120
# BROWSE_ALLOWLIST=
# BROWSE_CHROMIUM=/usr/bin/chromium
# BROWSE_CDP=http://127.0.0.1:9222

# The planner. Same story as GWS_MODEL: 3.8 Flash is global-only, so the
# location is its own rather than GOOGLE_CLOUD_LOCATION.
# PLAN_MODEL=gemini-3.8-flash
# PLAN_LOCATION=global

# Names besides `localhost` and `127.0.0.1` that this server will answer to.
# Added to those two, never in place of them: the kiosk is pointed at
# http://localhost:8000 under both topologies, so a setting that replaced the
# pair would take away the one browser the terminal has.
#
# It is a list of the server's own names and not of the pages that may call
# it, which is what a request's Host header carries. A request arriving under
# any other name is refused with a 400 before it reaches a route, which is
# what stops a page on a name the attacker has just repointed at this address
# from talking to the agent — its Origin and its Host agree, so the handshake
# check cannot tell it from ours.
#
# Leave it unset unless somebody browses the terminal by another name: a phone
# on the Wi-Fi at 192.0.2.10:8000, say, which also needs `--host 0.0.0.0`
# and gets no microphone, because http:// on anything but localhost is not a
# secure context. Comma-separated, one name per entry. A port is ignored if
# you write one, `*.example.com` matches a subdomain and not the bare name,
# and a bare `*` turns the guard off entirely and says so at startup.
#
# The whole list is written to the log at startup, and that line is the only
# account of it there is: a refusal is a bare `Invalid host header` with no
# log line behind it.
# ALLOWED_HOSTS=raspberrypi.local,192.0.2.10

# Optional Nest camera integration: your Device Access project ID.
SDM_PROJECT_ID=
